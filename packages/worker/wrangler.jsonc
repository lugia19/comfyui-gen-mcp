// Development and release config. deploy.sh merges the user's name and provisioned IDs from their
// copy of bootstrap/wrangler.jsonc into this file before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfy-gen",
  "main": "src/entry.py",
  // A date on or after 2026-09-08 selects Python 3.14.
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "vars": { "VERSION": "dev" },
  "kv_namespaces": [{ "binding": "KV" }],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "assets": {
    "directory": "../../web/dist",
    "not_found_handling": "single-page-application",
    // Everything else is the settings app, served without running (or billing) the Worker.
    "run_worker_first": ["/mcp/*", "/api/*", "/img/*", "/upload/*", "/build-callback"]
  },
  // Daily update check.
  "triggers": { "crons": ["17 4 * * *"] }
}
