// Development and release config. deploy.py merges the user's name (and any routes) from their copy
// of bootstrap/wrangler.jsonc into this file before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfy-gen",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": { "enabled": true },
  "vars": { "VERSION": "dev" },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "State" },
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["State"] }
  ],
  // Images and LoRAs (design §4). deploy.py names the bucket after the Worker; wrangler creates it.
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "comfy-gen-storage" }],
  "assets": {
    "directory": "../../web/dist",
    "not_found_handling": "single-page-application",
    // Everything else is the settings app, served without running (or billing) the Worker.
    "run_worker_first": ["/mcp/*", "/api/*", "/img/*", "/upload/*", "/build-callback", "/agent", "/agent/*", "/store/*"]
  },
  // Daily update check.
  "triggers": { "crons": ["17 4 * * *"] }
}
