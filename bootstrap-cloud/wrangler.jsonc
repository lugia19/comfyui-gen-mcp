// What the "Deploy to Cloudflare" button copies into your account. It holds configuration only:
// every build downloads the latest release's deploy.sh, which fetches the code, merges in the name
// from this file, and deploys. So this copy never needs updating. Storage (an R2 bucket) is added
// by the build once R2 is turned on in the account; the Worker's Setup page walks through that.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The button names your new repository after this, so it must never be comfy-gen-mcp or
  // comfy-dxt (see the repository's CLAUDE.md).
  "name": "comfy-gen",
  // src/ is not in this repository: deploy.sh downloads it at build time.
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "State" },
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["State"] }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  // Your answer on the setup site to "where should images be made?"; the Worker's Setup page
  // starts from it, and can change it.
  "vars": { "SETUP_MODE": "cloud" }
}
