{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfy-gen-spike-button",
  // src/ does not exist in this repository: deploy.sh downloads it at build time, the way the
  // product's build will download a release.
  "main": "src/entry.py",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "SPIKE_KV" }],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
